<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_scrap_unscrap_wizard_form" model="ir.ui.view">
        <field name="name">stock.scrap.unscrap.wizard.form</field>
        <field name="model">stock.scrap.unscrap.wizard</field>
        <field name="arch" type="xml">
            <form string="Unscrap">
                <group>
                    <field name="scrap_id" readonly="1"/>
                    <field name="product_id" readonly="1"/>
                    <field name="product_uom_id" readonly="1"/>
                    <field name="available_qty" readonly="1"/>
                    <field name="qty"/>
                    <field name="to_location_id"/>
                    <field name="reason"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm_unscrap" type="object" string="Confirm Unscrap" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
